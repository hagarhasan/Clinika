# ---- Database (Neon) ----
# انسخي الـ connection string من لوحة Neon (يفضل الـ Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Security ----
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=put-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- App ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TIMEZONE=Africa/Cairo
MAX_ADVANCE_BOOKING_DAYS=60
CANCEL_MIN_HOURS_BEFORE=2
AUTO_CONFIRM_APPOINTMENTS=false
AUTO_CREATE_TABLES=false

# ---- Cron (Vercel بيبعتها تلقائيا كـ Bearer token) ----
CRON_SECRET=another-long-random-string

# ---- Seed ----
ADMIN_EMAIL=admin@clinika.com
ADMIN_PASSWORD=Admin@12345

# ---- Frontend (لينك رسالة نسيت كلمة السر: {FRONTEND_URL}/reset-password?token=...) ----
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
REMEMBER_ME_EXPIRE_DAYS=30

# ---- Email (Resend: https://resend.com) — لو فاضي الإيميلات بتتجاهل من غير أخطاء ----
RESEND_API_KEY=
EMAIL_FROM=Clinika <onboarding@resend.dev>
CONTACT_RECEIVER_EMAIL=

# ---- Image uploads (Cloudinary) — لو فاضي رفع الصور بيرجّع 503 ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=3

# ---- Booking ----
# 120 = ممنوع حجز موعد يبدأ بعد أقل من ساعتين (0 = زي الأول)
MIN_BOOKING_NOTICE_MINUTES=0
NEXT_AVAILABLE_HORIZON_DAYS=21
ONLINE_MEETING_BASE_URL=https://meet.jit.si
