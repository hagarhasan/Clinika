{
  "name": "clinika-backend",
  "version": "1.0.0",
  "description": "Clinika — Clinic Management & Booking Platform API (Node.js + Express + PostgreSQL)",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
